{
  "name": "tma-saas-mvp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm run dev -w @tma/web",
    "dev:miniapp": "npm run dev -w @tma/miniapp",
    "build": "npm run build:api && npm run build -w @tma/web && npm run build -w @tma/miniapp",
    "build:api": "tsc -p tsconfig.json",
    "start": "node index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test -w @tma/web && npm run test -w @tma/miniapp",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
