  <div style="display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 16px; margin-top: 26px; align-items: stretch;">
    <div style="display: grid; justify-items: center; align-content: space-between; padding: 20px; border: 1px solid rgba(255,255,255,.12); border-radius: 22px; background: rgba(255,255,255,.05);">
      <div>__DUCK_236__</div>
      <div style="text-align: center;">
        <div style="font-size: 12.5px; font-weight: 700;">Герой обложки</div>
        <div style="margin-top: 3px; font-size: 11.5px; color: #A9A4D4;">240–380 px, стоит рядом с телефоном</div>
      </div>
    </div>

    <div style="display: grid; justify-items: center; align-content: space-between; padding: 20px; border: 1px solid rgba(255,255,255,.12); border-radius: 22px; background: rgba(255,255,255,.05);">
