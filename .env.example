NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tma_builder
PUBLIC_TMA_ORIGIN=https://apps.example.com
PUBLIC_CONSOLE_ORIGIN=https://console.example.com
PUBLIC_API_ORIGIN=https://api.example.com
# Bothost sets DOMAIN automatically. When DOMAIN is present, the three PUBLIC_*
# values may be omitted and https://$DOMAIN is used for all of them.
TRUST_PROXY_HOPS=0
# At least 32 random characters. In production prefer an asymmetric IdP/JWKS.
SESSION_JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=tma-studio-api
JWT_AUDIENCE=tma-studio-console
PASSWORD_PEPPER_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PASSWORD_PEPPER_ID=password-v1
REFRESH_TOKEN_HASH_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Production: replace LocalAesKek with AWS KMS / GCP KMS / Vault Transit.
TOKEN_KEK_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOKEN_KEK_ID=local-dev-v1
PAYMENT_PROVIDER=mock
RUN_TELEGRAM_WORKER=true
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
