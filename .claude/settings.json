{
  "model": "opus",
  "language": "russian",
  "askUserQuestionTimeout": "60s",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(psql *)",
      "Bash(pg_isready*)",
      "Bash(service postgresql *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(sed *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)"
    ]
  }
}
